# Default deployment settings, read automatically by `docker compose`.
# Change them here (or override them on the command line) instead of editing docker-compose.yml.

# Hazelcast server image version. It MUST match the Hazelcast client version in the parent pom.xml.
HAZELCAST_VERSION=5.7.0
HZ_CLUSTER_NAME=search-engine
# Heap of each Hazelcast member (fixed so that benchmarks are reproducible)
HZ_HEAP=512m

# Host ports where the two Hazelcast members are published (for services run from the IDE)
HZ1_HOST_PORT=5701
HZ2_HOST_PORT=5702

# MongoDB: inverted index and book metadata (database search_engine). Same image as Stage 1.
MONGO_VERSION=8.2.12
# Memory limit of the container and WiredTiger cache inside it (fixed: reproducible benchmarks;
# the cache must stay well below the limit, MongoDB also needs memory outside the cache)
MONGO_MEM_LIMIT=1g
MONGO_CACHE_GB=0.25
# Host port, bound to 127.0.0.1 only (tests and services run from the IDE)
MONGO_HOST_PORT=27017
# Connection string for the services that run INSIDE Docker (used from DP-08). Outside Docker the
# services default to mongodb://localhost:27017 (common -> MongoSettings).
MONGO_URI=mongodb://mongo:27017
