# Default deployment settings, read automatically by `docker compose`.
# Change them here (or override them on the command line) instead of editing docker-compose.yml.

# Hazelcast server image version. It MUST match the Hazelcast client version in the parent pom.xml.
HAZELCAST_VERSION=5.7.0
HZ_CLUSTER_NAME=search-engine
# Heap of each Hazelcast member (fixed so that benchmarks are reproducible)
HZ_HEAP=512m

# Host ports where the two Hazelcast members are published, on 127.0.0.1 only (for services run from the IDE)
HZ1_HOST_PORT=5701
HZ2_HOST_PORT=5702

# MongoDB: inverted index and book metadata (database search_engine). Same image as Stage 1.
MONGO_VERSION=8.2.12
# Memory limit of the container and WiredTiger cache inside it (fixed: reproducible benchmarks;
# the cache must stay well below the limit, MongoDB also needs memory outside the cache)
MONGO_MEM_LIMIT=1g
MONGO_CACHE_GB=0.25
# Host port, bound to 127.0.0.1 only (tests and services run from the IDE)
MONGO_HOST_PORT=27017
# Connection string for the services that run INSIDE Docker (used from DP-08). Outside Docker the
# services default to mongodb://localhost:27017 (common -> MongoSettings).
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=search_engine
MONGO_COLLECTION=inverted_index
MONGO_CPUS=2

# Resources of each container (fixed: reproducible benchmarks). With --scale the limits are per
# replica. One replica of each adds up to about 5.7 GB of limits; Docker must have that much.
HZ_CPUS=1
# Heap (HZ_HEAP) plus what the JVM needs outside it
HZ_MEM_LIMIT=768m
CONTROL_CPUS=0.5
CONTROL_MEM_LIMIT=384m
INGESTION_CPUS=1
INGESTION_MEM_LIMIT=512m
INDEXING_CPUS=2
INDEXING_MEM_LIMIT=1g
SEARCH_CPUS=2
SEARCH_MEM_LIMIT=1g
NGINX_CPUS=0.5
NGINX_MEM_LIMIT=128m
MC_CPUS=1
MC_MEM_LIMIT=1g
# Share of mem_limit for the heap of each Java service
JAVA_HEAP_PERCENT=75

# Images and ports published on the host
NGINX_VERSION=1.28-alpine
NGINX_HOST_PORT=8080
# On 127.0.0.1 only: no authentication
CONTROL_HOST_PORT=7000
MC_HOST_PORT=8081

# Datalake (bind mount: Ingestion writes, Indexing and the Control read). The books of
# INGESTION_SOURCE=local are the pg<id>.txt files of INGESTION_LOCAL_HOST_DIR, e.g.
# ../stage_1/sample_dataset/raw for the sample dataset, or the synthetic dataset of DR-16, which
# scripts/dataset/generate_dataset.py writes into data/books. If that folder does not exist, Docker
# creates it empty, so with INGESTION_SOURCE=local it must point to a folder that has the books.
DATALAKE_HOST_DIR=./data/datalake
INGESTION_LOCAL_HOST_DIR=./data/books

# Threads: <SERVICE>_HTTP_THREADS is the Jetty maximum of each process (Javalin's default, 250,
# made explicit); the others are the workers of each service. Change one at a time in the benchmarks.
CONTROL_HTTP_THREADS=250
INGESTION_HTTP_THREADS=250
INDEXING_HTTP_THREADS=250
SEARCH_HTTP_THREADS=250
INGESTION_WORKERS=4
INGESTION_FETCH_RETRIES=2
INDEXING_THREADS=4
INDEX_WRITE_BATCH=100
# Seconds a rebuild of the index keeps the old collection after the switch (Search may still read it)
INDEX_REBUILD_DROP_SECONDS=60

# Ingestion source: gutenberg (download) or local (see INGESTION_LOCAL_HOST_DIR)
INGESTION_SOURCE=gutenberg

# Coordination (contract §8) and publication (Control)
LEASE_SECONDS=120
MAX_ATTEMPTS=3
LEASE_CHECK_SECONDS=10
PUBLISH_BATCH=100
PUBLISH_INTERVAL_S=30

# Search: MongoDB connections per replica, seconds between checks of CURRENT, and the origins of
# the front-end allowed from a browser (comma-separated, or *; empty: none)
SEARCH_MONGO_POOL_SIZE=50
SEARCH_POLL_SECONDS=5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
