<?xml version="1.0" encoding="UTF-8"?>
<!--
  Code shared by every service (owner: Daniel Rodríguez; common/coordination: Carlos Falcón).
  A plain library jar, not executable: no shade plugin and no main class.
  Stage 1 code migrated in DR-02: model, datalake (range), tokenizer + stopwords and inverted
  index (MongoDB). Metadata in MongoDB too since DR-04 (MongoMetadataRepository, collection
  "books"). config holds Env, DataLayout and MongoSettings. coordination (CF-04) implements the
  Hazelcast contract, api/contracts/coordination.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>es.ulpgc.bigdata</groupId>
        <artifactId>stage2</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!-- Inverted index (MongoInvertedIndex) and metadata (MongoMetadataRepository) -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
        </dependency>
        <!-- Coordination (CF-04): the client, and in the tests two embedded members -->
        <dependency>
            <groupId>com.hazelcast</groupId>
            <artifactId>hazelcast</artifactId>
        </dependency>
        <!-- A library does not choose the logging backend; each service adds slf4j-simple. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Also publishes the test support (testsupport: the embedded Hazelcast cluster, the
                 MongoDB probe) as common-tests.jar, so the services' tests use the same one
                 (<type>test-jar</type>, test scope) instead of copying it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
