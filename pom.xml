<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent POM of the Stage 2 search engine (owner: Daniel Rodríguez, DR-01).

  It does not produce any code itself (packaging "pom"): it lists the modules and fixes, in ONE
  place, the Java version, the versions of every dependency and the build plugins. The modules
  declare a dependency or plugin WITHOUT a version and inherit it from here, so all services use
  exactly the same Javalin, Gson, Hazelcast...

  Build everything from the repository root:   mvn -B verify
  Build one service (and what it depends on):  mvn -B -pl indexing-service -am package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.ulpgc.bigdata</groupId>
    <artifactId>stage2</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Stage 2 search engine</name>

    <!-- common first: the services depend on it. Maven orders the build by dependencies anyway. -->
    <modules>
        <module>common</module>
        <module>ingestion-service</module>
        <module>indexing-service</module>
        <module>search-service</module>
        <module>control-module</module>
    </modules>

    <properties>
        <!-- release (not source/target): compiles against the Java 17 API even on a newer JDK -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <javalin.version>6.1.3</javalin.version>
        <gson.version>2.11.0</gson.version>
        <slf4j.version>2.0.9</slf4j.version>
        <sqlite.version>3.53.4.0</sqlite.version>
        <!-- MUST be the same as HAZELCAST_VERSION in .env (the server image in docker-compose.yml) -->
        <hazelcast.version>5.7.0</hazelcast.version>
        <junit.version>5.10.2</junit.version>
        <jmh.version>1.37</jmh.version>

        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <surefire-plugin.version>3.2.5</surefire-plugin.version>
        <shade-plugin.version>3.5.1</shade-plugin.version>
        <exec-plugin.version>3.1.0</exec-plugin.version>
    </properties>

    <!-- Versions only: a module gets a dependency when it declares it (without <version>). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>es.ulpgc.bigdata</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.javalin</groupId>
                <artifactId>javalin</artifactId>
                <version>${javalin.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>
            <!-- Since Hazelcast 5 the client is in the main artifact (there is no hazelcast-client). -->
            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast</artifactId>
                <version>${hazelcast.version}</version>
            </dependency>
            <!-- JMH: test scope only, benchmarks live in src/test/java (DR-12, enunciado §6.3). -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Every module gets JUnit 5 for its tests. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- target/<module>.jar: the name docker/service.Dockerfile expects -->
        <finalName>${project.artifactId}</finalName>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <!--
                  Fat jar for `java -jar`. The maven-jar-plugin of the enunciado's example does not put
                  Javalin, Gson... inside the jar, so it fails at startup with NoClassDefFoundError.
                  Each service activates it by listing the plugin and setting the main.class property.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${shade-plugin.version}</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals><goal>shade</goal></goals>
                            <configuration>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <transformers>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                        <mainClass>${main.class}</mainClass>
                                    </transformer>
                                    <!-- merges META-INF/services files (JDBC drivers, SLF4J...) instead of keeping one -->
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                </transformers>
                                <filters>
                                    <filter>
                                        <!-- signatures of the original jars are invalid inside the fat jar -->
                                        <artifact>*:*</artifact>
                                        <excludes>
                                            <exclude>META-INF/*.SF</exclude>
                                            <exclude>META-INF/*.DSA</exclude>
                                            <exclude>META-INF/*.RSA</exclude>
                                        </excludes>
                                    </filter>
                                </filters>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
